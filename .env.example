# Copy to .env and fill in. Never commit .env.
# deterministic_demo = no LLM calls (default, works offline) | live_llm = four LLM-backed agents
PROCESSING_MODE=deterministic_demo

# Which live provider the four agents use: gemini | groq | openrouter | ollama | openai_compat
# Check it any time with:  python scripts/check_llm.py
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# Seconds between calls (free tiers limit requests/minute). Gemini free: 8. Groq: 2. Ollama (local): 0.
LLM_MIN_INTERVAL_SECONDS=8

# --- Google Gemini (free tier: ~20 requests/day PER MODEL -> ~5 live invoices/day/model)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Groq (free tier, OpenAI-compatible, fast; much higher daily limits) - key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss / qwen3 are reasoning models; "low" makes each call ~5x faster and uses far fewer tokens/min (default for groq)
LLM_REASONING_EFFORT=low

# --- OpenRouter (free ':free' model variants; small daily limit without credits) - key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Ollama (local, no key, no quota; needs `ollama pull <model>`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Send page images of scanned invoices to OpenAI-compatible providers (only if the model supports vision)
LLM_VISION=false
