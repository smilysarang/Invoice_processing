# Copy to .env and fill in. Never commit .env.
# deterministic_demo = no LLM calls (default, works offline) | live_llm = four Gemini-backed agents
PROCESSING_MODE=deterministic_demo

LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Verify the model ID before the demo:  python scripts/check_gemini.py
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
# Free-tier pacing between calls (requests-per-minute limits). 4 agents x N invoices.
LLM_MIN_INTERVAL_SECONDS=4
